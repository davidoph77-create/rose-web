{
  "expo": {
    "name": "Rose IA",
    "slug": "rose-ia",
    "scheme": "roseia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.davidoph.roseia",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "@react-native-voice/voice",
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "googleWebClientId": "705330769466-7tcvltceskebfhekf1ggim89aeiej41l.apps.googleusercontent.com",
      "eas": {
        "projectId": "2df5ecc5-001f-4608-9053-98a53cc29285"
      }
    }
  }
}
