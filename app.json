{
  "expo": {
    "name": "Rose IA",
    "slug": "rose-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.davidoph.roseia",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-voice/voice",
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "expo-notifications"
    ],
    "extra": {
      "googleWebClientId": "705330769466-7tcvltceskebfhekf1ggim89aeiej41l.apps.googleusercontent.com"
    }
  }
}